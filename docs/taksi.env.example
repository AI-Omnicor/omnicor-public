# taksi.env.example — OMNICOR CGT chain interface for the taksi platform
# (backend/internal/omnilink). Values below are the current DEVNET
# rehearsal deployment on chain 420902 (L1 = local anvil 31337).
# Addresses are nonce-deterministic; see omnicor/deployments.md.

# --- network ---
RPC_URL=http://127.0.0.1:8845          # op-reth EL HTTP RPC (CGT chain)
CHAIN_ID=420902
NATIVE_TOKEN_SYMBOL=OMNI               # custom gas token; fees paid in OMNI

# --- core app contracts (omnicor/contracts/src/) ---
WOMNI_ADDRESS=0xc63d2a04762529edB649d7a4cC3E57A0085e8544
OMNI_BURNER_ADDRESS=0xBa3e08b4753E68952031102518379ED2fDADcA30
OMNI_FEE_SPLITTER_ADDRESS=0x35D2F51DBC8b401B11fA3FE04423E0f5cd9fEDb4  # deploys at app-layer b+9; filled by update_taksi_env.py after redeploy
OMNI_L2_BRIDGE_ADDRESS=0x7290f72B5C67052DDE8e6E179F7803c493e90d3f
OMNICOR_TREASURY_ADDRESS=0x23d351BA89eaAc4E328133Cb48e050064C219A1E

# --- AMM (canonical Uniswap V2: factory creates CREATE2 pairs, router
#     is the swap entry point) ---
OMNI_FACTORY_ADDRESS=0x34ee84036C47d852901b7069aBD80171D9A489a6  # UniswapV2Factory; filled by update_taksi_env.py
OMNI_ROUTER_ADDRESS=0xa85b028984bC54A2a3D844B070544F59dDDf89DE   # UniswapV2Router02; filled by update_taksi_env.py
OMNI_RU_PAIR=0x2e79fb9360d8a45383939877bcf9ce9048f54439     # WOMNI / rRUB
OMNI_INTL_PAIR=0x37c0a78e8d5a0f7487ec26a45ad5c41ac01c349c  # WOMNI / USDT

# --- quote tokens (devnet mocks; production tickers identical) ---
RRUB_TOKEN=0x1a6a3e7Bb246158dF31d8f924B84D961669Ba4e5
USDT_TOKEN=0x093e8F4d8f267d2CeEc9eB889E2054710d187beD

# --- interface notes for omnilink ---
# * Pair spot price: read getReserves() + token0() and compute
#   reserveQuote*1e18/reserveWOMNI locally — canonical pairs expose
#   TWAP accumulators (price0CumulativeLast) not a spot getter
# * Router quotes: getAmountsOut(uint256,address[]) /
#   getAmountsIn(uint256,address[]); swaps:
#   swapExactTokensForTokens / swapExactETHForTokens (ETH = OMNI)
# * Raw pair swap: swap(uint256,uint256,address,bytes) — the 4-arg
#   canonical signature; send input tokens first, empty bytes data
# * OMNIBurner.burnDirect() payable — burns msg.value native OMNI,
#   emits Burned(amount, caller), increments totalBurned()
# * FeeSplitter.sweep() — permissionless; splits its whole native
#   balance: 70% -> OMNIBurner (dead), 30% -> OMNICORTreasury.
#   Ratio is a hardcoded constant (BURN_BPS=7000), no admin path.
#   Fee-vault withdrawals should route HERE, not to the raw burner.
# * Revenue-linked reserve burn (debt ledger): the platform books a
#   buyback obligation per ride and fixes its OMNI amount at the rate
#   on the record date; the Safe periodically burns that exact OMNI
#   sum on L1 via .devnet-tools/revenue_burn.py --omni — no market
#   purchase needed.
# * OMNICORTreasury: owner-gated; executor(uint8 contour) +
#   coldWallet(uint8 contour) (0=RU, 1=INTL); topUpExecutor /
#   sweepToCold move native OMNI; server keeps only cold ADDRESSES
# * OMNIL2Bridge.withdrawTo(address,uint32) payable — L2->L1 withdrawal
# * OMNICORToken on L1: 0x948B3c65b89DF0B4894ABE91E6D02FE579834F8F
#   (OMNIL1Bridge 0x85C5Dd61585773423e378146D4bEC6f8D149E248 locks it for
#   deposits — L1 address; same hex as the OLD SimplePair RU pool was
#   by nonce coincidence — the canonical OMNI_RU_PAIR above is a
#   different CREATE2-derived address, different chains anyway)

# --- L1 settlement verification (platform reads these for
#     /admin/omni/run/settle — on-chain verify of the Safe burn tx:
#     Transfer->0x...dEaD on OMNICORToken, exact wei vs ledger sum) ---
OMNI_L1_RPC_URL=http://127.0.0.1:9545      # L1 RPC (devnet anvil 31337); prod: https://...
OMNI_L1_TOKEN=0x948B3c65b89DF0B4894ABE91E6D02FE579834F8F  # OMNICORToken L1

# --- platform toggles (platform side; keep disabled until mainnet) ---
OMNI_ENABLED=0
