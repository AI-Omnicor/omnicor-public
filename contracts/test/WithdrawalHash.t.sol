pragma solidity 0.8.25;
import { Test } from "forge-std/Test.sol";
contract WithdrawalHashTest is Test {
    function testHash() public {
        uint256 nonce = 1766847064778384329583297500742918515827483896875618958121606201292619776;
        bytes memory data = hex"";
        bytes32 h = keccak256(abi.encode(nonce, 0x4200000000000000000000000000000000000007, 0x03809A2643AEa02B95cB4840e58C7e1665AA0fe7, uint256(0), uint256(463628), data));
        // Pinned reproduction of the withdrawal-hash preimage used on the
        // live devnet: guards against accidental encoding drift.
        assertEq(h, 0xb784f578649f9ab99b43def08bce83aee8d52de81c37b1e0ee63490b409ab08f);
        assertEq(data.length, 324);
    }
}
